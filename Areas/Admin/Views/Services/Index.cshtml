@model IEnumerable<WoodHome.Domain.Entities.Service>
@{
    ViewData["Title"] = "Управление услугами";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 pt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-title">Услуги</h2>
        <a href="/Admin/Services/Create" class="btn-gold">Добавить услугу</a>
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-hover">
            <thead>
                <tr>
                    <th>Фото</th>
                    <th>Название</th>
                    <th>Категория</th>
                    <th>Активна</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Photo))
                            {
                                <img src="@item.Photo" style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px;" />
                            }
                        </td>
                        <td>@item.Title</td>
                        <td>@item.ServiceCategory?.Name</td>
                        <td>@(item.IsActive ? "Да" : "Нет")</td>
                        <td>
                            <a href="/Admin/Services/Edit/@item.Id" class="btn btn-sm btn-outline-warning">Изменить</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Удалить?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>