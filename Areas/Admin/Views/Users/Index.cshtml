@model IEnumerable<WoodHome.Areas.Admin.Controllers.UserRoleViewModel>
@{
    ViewData["Title"] = "Управление пользователями";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 pt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-title">Пользователи</h2>
        <a href="/Admin/Dashboard" class="btn-outline-gold">Назад в панель</a>
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-hover">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Имя</th>
                    <th>Роли</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Email</td>
                        <td>@user.FullName</td>
                        <td>
                            @if (user.Roles.Any())
                            {
                                @foreach (var role in user.Roles)
                                {
                                    <span class="badge bg-gold text-dark me-1">@role</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Нет ролей</span>
                            }
                        </td>
                        <td>
                            <a href="/Admin/Users/EditRoles?userId=@user.UserId" class="btn btn-sm btn-outline-warning">Изменить роли</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>