@model WoodHome.Models.ViewModels.ContactSettingsViewModel

@{
    ViewData["Title"] = "Настройки контактов";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 pt-5 mb-5">
    <div class="admin-page-header mb-4">
        <h1 class="page-title">Настройки контактов</h1>
        <p class="text-muted">
            Здесь можно изменить контактную информацию, которая отображается на сайте.
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="admin-card p-4">
        <form asp-area="Admin"
              asp-controller="ContactSettings"
              asp-action="Index"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="Address" class="form-label">
                    Адрес компании
                </label>
                <input asp-for="Address"
                       class="form-control"
                       placeholder="Введите адрес компании" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Phone" class="form-label">
                    Телефон
                </label>
                <input asp-for="Phone"
                       type="tel"
                       class="form-control"
                       placeholder="+7 (999) 123-45-67" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Email" class="form-label">
                    Электронная почта
                </label>
                <input asp-for="Email"
                       type="email"
                       class="form-control"
                       placeholder="example@mail.ru" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="MapUrl" class="form-label">
                    Ссылка на карту
                </label>
                <input asp-for="MapUrl"
                       class="form-control"
                       placeholder="Вставьте ссылку на карту" />
                <span asp-validation-for="MapUrl" class="text-danger"></span>
                <small class="text-muted">
                    Укажите ссылку на карту, если хотите отображать её на странице контактов.
                </small>
            </div>

            <div class="d-flex flex-wrap gap-3 mt-4">
                <button type="submit" class="gold-button">
                    Сохранить изменения
                </button>

                <a asp-area="Admin"
                   asp-controller="Dashboard"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Назад
                </a>
            </div>
        </form>
    </div>
</div>
}
