@model WoodHome.Domain.Entities.CompanyInfo

@{
    ViewData["Title"] = "Контакты";
    var address = Model?.Address ?? "426008, Удмуртская Республика, г. Ижевск, ул. Пушкинская, 268";
    var phone = Model?.Phone ?? "Телефон уточняется";
    var email = Model?.Email ?? "Электронная почта уточняется";
}

<section class="page-heading">
    <div class="container">
        <div class="hero-label">
            <span></span>
            WOODHOME
        </div>

        <h1>Свяжитесь с нами</h1>

        <p>
            Ответим на ваши вопросы, поможем выбрать проект
            и рассчитаем стоимость строительства вашего дома.
        </p>
    </div>
</section>

<section class="contacts-section">
    <div class="container">

        <div class="row g-4">

            <div class="col-md-4">
                <div class="contact-card">
                    <div class="contact-icon">⌖</div>
                    <h3>Наш адрес</h3>
                    <p>@address</p>
                    <span>Приезжайте к нам на встречу</span>
                </div>
            </div>

            <div class="col-md-4">
                <div class="contact-card">
                    <div class="contact-icon">↗</div>
                    <h3>Телефон</h3>
                    <p>
                        @if (!string.IsNullOrWhiteSpace(Model?.Phone))
                        {
                            <a href="tel:@Model.Phone">@phone</a>
                        }
                        else
                        {
                            @phone
                        }
                    </p>
                    <span>Будем рады вашему звонку</span>
                </div>
            </div>

            <div class="col-md-4">
                <div class="contact-card">
                    <div class="contact-icon">✉</div>
                    <h3>Электронная почта</h3>
                    <p>
                        @if (!string.IsNullOrWhiteSpace(Model?.Email))
                        {
                            <a href="mailto:@Model.Email">@email</a>
                        }
                        else
                        {
                            @email
                        }
                    </p>
                    <span>Напишите нам в любое время</span>
                </div>
            </div>

        </div>

        <div class="contacts-map-section">
            <div class="section-heading">
                <span class="section-label">МЫ НА КАРТЕ</span>
                <h2>Как нас найти</h2>
                <p>@address</p>
            </div>

            <div class="contacts-map">
                <iframe
                    src="https://yandex.ru/map-widget/v1/?text=МВЕУ%2C%20Ижевск%2C%20Пушкинская%2C%20268"
                    width="100%"
                    height="420"
                    frameborder="0"
                    allowfullscreen="true"
                    loading="lazy">
                </iframe>
            </div>
        </div>

        <div class="contacts-form-section">
            <div class="row g-5 align-items-center">

                <div class="col-lg-5">
                    <span class="section-label">ОСТАЛИСЬ ВОПРОСЫ?</span>
                    <h2>Давайте обсудим ваш будущий дом</h2>
                    <p>
                        Оставьте заявку, и наш менеджер свяжется
                        с вами, чтобы обсудить детали проекта.
                    </p>
                </div>

                <div class="col-lg-7">
                    <form asp-controller="Home"
                          asp-action="SendRequest"
                          method="post"
                          class="contacts-form">

                        @Html.AntiForgeryToken()

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label for="ClientName">Ваше имя</label>
                                <input type="text"
                                       id="ClientName"
                                       name="ClientName"
                                       class="form-control"
                                       placeholder="Как к вам обращаться?"
                                       maxlength="100"
                                       required />
                            </div>

                            <div class="col-md-6">
                                <label for="Phone">Телефон</label>
                                <input type="tel"
                                       id="Phone"
                                       name="Phone"
                                       class="form-control"
                                       placeholder="+7 (___) ___-__-__"
                                       maxlength="30"
                                       required />
                            </div>

                            <div class="col-12">
                                <label for="Email">Электронная почта</label>
                                <input type="email"
                                       id="Email"
                                       name="Email"
                                       class="form-control"
                                       placeholder="example@mail.ru"
                                       maxlength="100" />
                            </div>

                            <div class="col-12">
                                <label for="Message">Ваше сообщение</label>
                                <textarea id="Message"
                                          name="Message"
                                          class="form-control"
                                          rows="4"
                                          maxlength="2000"
                                          placeholder="Расскажите, какой дом вы хотите построить..."></textarea>
                            </div>

                            <div class="col-12">
                                <button type="submit" class="gold-button">
                                    Отправить заявку <span>→</span>
                                </button>
                            </div>

                        </div>
                    </form>
                </div>

            </div>
        </div>

    </div>
</section>
